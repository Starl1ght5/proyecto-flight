{
  "mcpServers": {
    "filesystem": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--mount", "type=bind,src=./info,dst=/projects/Desktop",
        "mcp/filesystem",
        "/projects"
      ]
    },
    "dbhub": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--init",
        "--add-host", "host.docker.internal:host-gateway",
        "--publish",
        "9080:9080",
        "bytebase/dbhub",
        "--transport",
        "stdio",
        "--port",
        "9080",
        "--dsn",
        "mysql://root:estajoda@host.docker.internal:3306/RoyalDB"
      ]
    }
  }
}